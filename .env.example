# Database: SQLite for MVP. For PostgreSQL see README ("Переход на PostgreSQL").
DATABASE_URL="file:./dev.db"

# Secret for signing session cookies (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# File storage driver: "local" (default), "r2" (Cloudflare binding) or "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Future AI integrations (all optional)
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.1"
# ELEVENLABS_API_KEY=""
# AVATAR_PROVIDER=""   # e.g. "heygen" | "d-id" (not implemented yet)

# "Sign in with Google" (both values enable the button). Redirect URI to register in Google Cloud:
# http://localhost:3000/api/auth/google/callback (and https://<your-domain>/api/auth/google/callback)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# APP_URL="https://memory.example.com"   # public origin, only if a proxy rewrites the Host header

# Security
# VOICE_MAX_MB="300"            # max upload size of one recording
# APP_ORIGINS="example.com"     # extra hosts allowed to POST to the API (comma-separated)
# TURNSTILE_SITE_KEY=""         # Cloudflare Turnstile on login/registration (both keys enable it)
# TURNSTILE_SECRET_KEY=""
# SHOW_DEMO_LOGIN="1"           # show the demo credentials hint in production
