{
  "name": "family-memory-ai",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "dev:cf": "CF_DEV=1 next dev",
    "build": "tsx scripts/gen-d1-bootstrap.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "d1:migrate": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "d1:seed": "tsx scripts/d1-seed-sql.ts && wrangler d1 execute DB --local --file .wrangler/d1-seed.sql",
    "d1:seed:remote": "tsx scripts/d1-seed-sql.ts && wrangler d1 execute DB --remote --file .wrangler/d1-seed.sql",
    "d1:migration:new": "wrangler d1 migrations create DB"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@opennextjs/cloudflare": "^1.20.10",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-progress": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "jose": "^5.10.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.460.0",
    "next": "^15.5.27",
    "react": "19.1",
    "react-dom": "19.1",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  },
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
