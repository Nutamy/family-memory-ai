# Local secrets for `npm run cf:preview` / `npm run dev:cf` (copy to .dev.vars).
# In production set each one with: npx wrangler secret put <NAME>
# Signs session cookies; required in production
AUTH_SECRET="generate: openssl rand -base64 48"
NEXTJS_ENV="development"
