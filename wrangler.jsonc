// Cloudflare Workers config for the OpenNext build. Step-by-step setup: docs/cloudflare.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-memory-ai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-memory-db",
      "database_id": "7fd82484-d0b9-4665-98f7-33c33e0b1eb7",
      "migrations_dir": "prisma/migrations-d1"
    }
  ],
  // Private bucket for audio and photos: files are served only through authorized API routes.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "family-memory-files" }],

  // Non-secret settings. Secrets (TELEGRAM_BOT_TOKEN, ...) go through `wrangler secret put`.
  "vars": {
    "STORAGE_DRIVER": "r2",
    // "guest": no sign-in, the bot links each visitor's Telegram (src/lib/auth-mode.ts).
    "AUTH_MODE": "guest",
    // Optional: put the site behind Cloudflare Access instead (docs/cloudflare.md, appendix).
    // Values used before switching to guest mode: misty-rain-abed.cloudflareaccess.com,
    // AUD 7f76fdbf967b738661ac5419b645a6392d2901c5a67e9dce5ca268fc3113542f.
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    // Telegram: each recording is one document; bigger files are cut into chunks of this size.
    // 30 MB keeps memory well under the 128 MB isolate limit; 5 documents per request
    // stays within the Free plan's 50 subrequests.
    "TELEGRAM_PART_MB": "30",
    "TELEGRAM_BATCH": "5",
    // Workers accept request bodies up to 100 MB.
    "VOICE_MAX_MB": "90"
  }
}
