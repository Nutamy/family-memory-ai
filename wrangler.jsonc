// Cloudflare Workers config for the OpenNext build. Step-by-step setup: docs/cloudflare.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-memory-ai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },

  // Paste the database_id printed by `npx wrangler d1 create family-memory-db`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-memory-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "prisma/migrations-d1"
    }
  ],
  // Private bucket for audio and photos: files are served only through authorized API routes.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "family-memory-files" }],

  // Non-secret settings. Secrets (TELEGRAM_BOT_TOKEN, ...) go through `wrangler secret put`.
  "vars": {
    "STORAGE_DRIVER": "r2",
    // Sign-in through Cloudflare Access (docs/cloudflare.md, step 8). Both values are public.
    // Team domain: "<team>.cloudflareaccess.com"; AUD: the Access application's audience tag
    // (optional but recommended: without it tokens of any app in this team are accepted).
    "CF_ACCESS_TEAM_DOMAIN": "misty-rain-abed.cloudflareaccess.com",
    "CF_ACCESS_AUD": "",
    // Telegram: each recording is one document; bigger files are cut into chunks of this size.
    // 30 MB keeps memory well under the 128 MB isolate limit; 5 documents per request
    // stays within the Free plan's 50 subrequests.
    "TELEGRAM_PART_MB": "30",
    "TELEGRAM_BATCH": "5",
    // Workers accept request bodies up to 100 MB.
    "VOICE_MAX_MB": "90"
  }
}
